# Copy to ~/.config/agent-bridge/slack.env and chmod 600. Never commit the real file.
# Bot User OAuth token (starts with xoxb-), from OAuth & Permissions.
SLACK_BOT_TOKEN=
# App-level token with connections:write (starts with xapp-), from Basic Information.
SLACK_APP_TOKEN=

# Optional path overrides (shell environment or systemd Environment= lines).
# AGENT_BRIDGE_CONFIG=~/.config/agent-bridge/config.json
# AGENT_BRIDGE_SLACK_ENV=~/.config/agent-bridge/slack.env
# AGENT_BRIDGE_STATE=~/.local/state/agent-bridge
# AGENT_BRIDGE_SERVICE=agent-bridge.service
# AGENT_BRIDGE_PYTHON=/path/to/agent-chat-bridge/.venv/bin/python
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_SESSIONS_DIR=/mnt/c/Users/YOU/.codex/sessions
# CHAT_FILE_MCP_ROOT=/path/to/agent-chat-bridge/exchange
